hostname = zhcn.api.wordln.com, api.fengkuangapp.com, api.mycake.me, mapi.kouyuxingqiu.com, api.lispod.cn, du.baicizhan.com, watch.taotiangou.cn, api.skyai.tech, api.mimuapp.com, www.duobeidanci.com, dict.youdao.com